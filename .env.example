# Spotify API Credentials (Required for Spotify enrichment)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Discogs API Credentials (Optional - leave empty to disable)
DISCOGS_TOKEN=

# Feature Toggles
ENABLE_SPOTIFY=true
ENABLE_YOUTUBE=true
ENABLE_DISCOGS=false
ENABLE_SPOTIFY_PLAYLISTS=true
AUTO_CREATE_SPOTIFY_PLAYLIST=true   # Skip confirmation prompt, create playlist automatically
ENABLE_HTML_OUTPUT=true             # Generate self-contained interactive HTML setlist page

# Notifications (ntfy.sh)
NTFY_TOPIC=your-ntfy-topic          # Your ntfy.sh topic (leave empty to disable)

# Recognition Settings
SEGMENT_DURATION=30
SEGMENT_OVERLAP=15
MIN_CONFIDENCE_THRESHOLD=8

# Crash Recovery Settings
ENABLE_CHECKPOINTS=true
CHECKPOINT_INTERVAL=10

# Shazam Recognition Settings
RECOGNITION_TIMEOUT=15

# Retry Settings (for 429 rate limit handling)
# Uses JitterRetry: exponential backoff with randomness to avoid thundering herd
MAX_RETRIES=5
BACKOFF_DELAY=1                      # Base delay, where delay = base * (2 ** retry_count)
MAX_BACKOFF_DELAY=60
JITTER_INTERVAL_SIZE=4.0             # Random jitter range is (0, size^2) seconds per retry

# Concurrency Settings
CONCURRENT_RECOGNITIONS=2
BATCH_SIZE=20

# Quota-Aware Throttling Settings
# When retries are exhausted due to 429, pause all requests for cooldown
QUOTA_COOLDOWN_DURATION=60          # Seconds to wait when quota exhausted (default: 3 minutes)

# Cleanup Settings
CLEANUP_TEMP_FILES=true      # Don't leep audio and segment files
CLEANUP_CHECKPOINTS=false     # Keep checkpoint files

# Advanced Clustering Settings
MIN_CLUSTER_SIZE=3
MIN_CLUSTER_DENSITY=0.25              # Minimum density (detections/span) to accept cluster
MIN_UNKNOWN_GAP_SIZE=6

# Temporal Overlap Resolution
# When tracks overlap in time, keeps the dominant one using multi-criteria scoring
OVERLAP_RESOLUTION_ENABLED=true
OVERLAP_THRESHOLD=0.3                  # 30% overlap to consider tracks competing

# DJ Set Discovery Settings (artist name mode)
DISCOVERY_RESULTS_PER_QUERY=20         # Results per yt-dlp search query
MIN_SET_DURATION_MINUTES=20            # Minimum duration to consider a result a DJ set
MAX_SETS_PER_ARTIST=0                  # Max sets to process per artist (0 = no limit)
